<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Penny Lunch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="PennyLunch">
    <meta name="application-name" content="Penny Lunch">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f97316">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/pen.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48">
    <link rel="icon" href="/icon-64x64.png" type="image/png" sizes="64x64">
    <link rel="icon" href="/icon-192x192.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/icon-512x512.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="mask-icon" href="/pen.svg" color="#f97316">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "basecoat/basecoat-vega-1.0.1.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_cards", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_toolbar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_ingredients_fab", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/basecoat-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/combobox-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/dropdown-menu-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-[100dvh] bg-background text-foreground" data-controller="recipe-ui ingredient-matches" data-action="turbo:visit@document->recipe-ui#startLoading turbo:before-render@document->recipe-ui#stopLoading turbo:load@document->recipe-ui#turboLoad turbo:render@document->recipe-ui#turboRender turbo:frame-render@document->recipe-ui#turboFrameRender turbo:fetch-request-error@document->recipe-ui#stopLoading recipes:updated@document->recipe-ui#recipesUpdated recipes:updated@document->ingredient-matches#refresh turbo:frame-render@document->ingredient-matches#refresh pennylunch:ingredient-basket-change@window->ingredient-matches#refresh">
    <script type="application/json" id="recipe-ui-catalog" data-recipe-ui-catalog><%== json_escape(recipe_ui_catalog_json) %></script>
    <%= yield %>
    <%= render "recipes/ingredients_fab", filters: recipe_layout_fab_filters %>
  </body>
</html>
