<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Penny Lunch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Penny Lunch">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "basecoat/basecoat-vega-1.0.1.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_cards", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_toolbar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipe_ingredients_fab", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/basecoat-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/combobox-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "basecoat/dropdown-menu-1.0.1.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "infinite_scroll", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "recipe_filters", defer: true, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-[100dvh] bg-background text-foreground">
    <%= yield %>
    <% if defined?(@recipe_ingredient_options) && !@recipe_ingredient_options.nil? %>
      <%= render "recipes/ingredients_fab", filters: @recipe_fab_filters || {}, ingredient_options: @recipe_ingredient_options %>
    <% end %>
  </body>
</html>
