<% fab_filters = (local_assigns[:filters] || {}).to_h.with_indifferent_access %>
<% fab_ingredient_options = Array(local_assigns[:ingredient_options]) %>

<section id="recipe-ingredients-fab" class="recipe-ingredients-fab" data-turbo-permanent data-ingredients-fab data-current-ingredients="<%= fab_filters["ingredients"].to_s %>" data-current-enabled="<%= fab_filters["ingredients"].present? ? "true" : "false" %>" data-ingredient-options="<%= fab_ingredient_options.to_json %>">
  <div id="recipe-ingredients-panel" class="recipe-ingredients-panel card" data-ingredients-filter-panel hidden>
    <header class="space-y-1 p-4">
      <div class="flex items-start justify-between gap-3">
        <div class="space-y-1">
          <h2 class="text-base font-semibold">Ingredients at home</h2>
          <p class="text-sm leading-5 text-muted-foreground">Pick matching ingredients. Enable to include them in filters.</p>
        </div>
        <label class="recipe-ingredients-switch shrink-0 cursor-pointer" data-state="disabled">
          <%= tag.input type: "checkbox", class: "sr-only", role: "switch", aria: { label: "Use ingredients in filters" }, data: { ingredients_filter_enabled: true } %>
          <span class="recipe-ingredients-switch-track" aria-hidden="true">
            <span class="recipe-ingredients-switch-thumb"></span>
          </span>
          <span class="recipe-ingredients-switch-text" data-ingredients-enable-text>Off</span>
        </label>
      </div>
    </header>

    <section class="recipe-ingredients-picker min-h-0 space-y-3 px-4 pb-4">
      <div class="space-y-2">
        <label for="recipe-ingredients-input" class="text-sm font-medium">Add ingredient</label>
        <input id="recipe-ingredients-input" class="input h-10 w-full" type="text" placeholder="Start typing, then choose a match" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="recipe-ingredients-options" data-ingredients-filter-input>
        <div id="recipe-ingredients-options" class="recipe-ingredients-options rounded-md border bg-popover shadow-sm" role="listbox" data-ingredients-filter-options hidden></div>
        <p class="text-xs text-muted-foreground" data-ingredients-filter-help>Only known ingredients can be added. Disabled selections stay saved but are not sent to search.</p>
      </div>

      <div class="recipe-ingredients-selected min-h-0 rounded-md border bg-muted/40 p-2">
        <div class="recipe-ingredients-selected-list" data-empty-text="No ingredients selected yet." data-ingredients-selected-list></div>
      </div>
    </section>
  </div>

  <button type="button" class="btn recipe-ingredients-fab-button" data-variant="outline" data-ingredients-fab-trigger data-state="disabled" data-tooltip="Ingredients: add what you have" data-side="left" data-align="center" aria-label="Ingredients: add what you have" aria-controls="recipe-ingredients-panel" aria-expanded="false">
    <%= icon_svg(:ingredients, class_name: "size-5") %>
    <span class="sr-only" data-ingredients-fab-status>Add what you have</span>
  </button>
</section>
