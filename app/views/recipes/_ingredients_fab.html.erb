<% fab_filters = (local_assigns[:filters] || {}).to_h.with_indifferent_access %>
<% fab_ingredients_enabled = fab_filters["ingredients"].to_s.strip.present? %>

<section id="recipe-ingredients-fab" class="recipe-ingredients-fab" data-turbo-permanent data-controller="ingredients-fab" data-ingredients-fab-current-ingredients-value="<%= fab_filters["ingredients"].to_s %>" data-action="keydown->ingredients-fab#escape pointerdown@document->ingredients-fab#closeFromOutside turbo:load@document->ingredients-fab#refreshPageContext">
  <div id="recipe-ingredients-panel" class="recipe-ingredients-panel" data-ingredients-fab-target="panel" hidden>
    <header>
      <div class="recipe-ingredients-panel-header">
        <div class="recipe-ingredients-panel-copy">
          <h2 class="recipe-ingredients-panel-title">Market basket</h2>
          <p class="recipe-ingredients-filter-status">
            <span>When</span>
            <label class="recipe-ingredients-switch" data-state="<%= fab_ingredients_enabled ? "enabled" : "disabled" %>" data-ingredients-fab-target="enabledControl">
              <%= tag.input type: "checkbox", class: "sr-only", role: "switch", checked: fab_ingredients_enabled, aria: { label: "Use ingredients in filters" }, data: { ingredients_fab_target: "enabledInput", action: "change->ingredients-fab#changeEnabled" } %>
              <span class="recipe-ingredients-switch-track" aria-hidden="true">
                <span class="recipe-ingredients-switch-thumb"></span>
              </span>
              <span class="recipe-ingredients-switch-text" data-ingredients-fab-target="enabledText"><%= fab_ingredients_enabled ? "On" : "Off" %></span>
            </label>
            <span data-ingredients-fab-target="modeText"><%= fab_ingredients_enabled ? "only matching recipes are displayed." : "you see all recipes." %></span>
          </p>
        </div>
      </div>
    </header>

    <section class="recipe-ingredients-picker">
      <div class="recipe-ingredients-selected">
        <div class="recipe-ingredients-empty-state">
          <p class="recipe-ingredients-empty-state-phrase">Add what is in your kitchen. Matching recipes move to the front.</p>
        </div>
        <div class="recipe-ingredients-selected-list" data-ingredients-fab-target="selectedList"></div>
      </div>

      <div class="recipe-ingredients-field">
        <div class="recipe-ingredients-input-group">
          <input id="recipe-ingredients-input" class="input" type="text" placeholder="Tomato, eggs, parsley..." autocomplete="off" role="combobox" aria-label="Ingredient name" aria-autocomplete="list" aria-expanded="false" aria-controls="recipe-ingredients-options" data-ingredients-fab-target="input" data-action="input->ingredients-fab#search keydown->ingredients-fab#keydown blur->ingredients-fab#blur">
        </div>
        <div id="recipe-ingredients-options" class="recipe-ingredients-options" role="listbox" data-ingredients-fab-target="options" hidden></div>
      </div>
    </section>
  </div>

  <button type="button" class="btn recipe-ingredients-fab-button" data-variant="outline" data-ingredients-fab-target="trigger" data-action="click->ingredients-fab#toggle" data-state="disabled" data-tooltip="Ingredients: add what you have" data-side="left" data-align="center" aria-label="Ingredients: add what you have" aria-controls="recipe-ingredients-panel" aria-expanded="false">
    <%= icon_svg(:ingredients, class_name: "recipe-ingredients-fab-icon") %>
    <span class="sr-only" data-ingredients-fab-target="status">Add what you have</span>
  </button>
</section>
