<% fab_filters = (local_assigns[:filters] || {}).to_h.with_indifferent_access %>
<% fab_ingredient_names = Array(fab_filters["ingredients"]).compact_blank %>
<% fab_ingredients_enabled = fab_ingredient_names.any? %>

<section id="recipe-ingredients-fab" class="recipe-ingredients-fab" data-turbo-permanent data-controller="ingredients-fab" data-ingredients-fab-current-ingredients-value="<%= fab_ingredient_names.to_json %>" data-action="keydown->ingredients-fab#escape pointerdown@document->ingredients-fab#closeFromOutside turbo:load@document->ingredients-fab#refreshPageContext pennylunch:add-basket-ingredient@window->ingredients-fab#addIngredientFromEvent pennylunch:remove-basket-ingredient@window->ingredients-fab#removeIngredientFromEvent">
  <div id="recipe-ingredients-panel" class="recipe-ingredients-panel" data-ingredients-fab-target="panel" hidden>
    <header>
      <div class="recipe-ingredients-panel-header">
        <div class="recipe-ingredients-panel-copy">
          <h2 class="recipe-ingredients-panel-title">Market basket</h2>
          <p class="recipe-ingredients-filter-status">
            <span>When</span>
            <label class="recipe-ingredients-switch" data-state="<%= fab_ingredients_enabled ? "enabled" : "disabled" %>" data-ingredients-fab-target="enabledControl">
              <%= tag.input type: "checkbox", class: "sr-only", role: "switch", checked: fab_ingredients_enabled, aria: { label: "Use ingredients in filters" }, data: { ingredients_fab_target: "enabledInput", action: "change->ingredients-fab#changeEnabled" } %>
              <span class="recipe-ingredients-switch-track" aria-hidden="true">
                <span class="recipe-ingredients-switch-thumb"></span>
              </span>
              <span class="recipe-ingredients-switch-text" data-ingredients-fab-target="enabledText"><%= fab_ingredients_enabled ? "On" : "Off" %></span>
            </label>
            <span data-ingredients-fab-target="modeText"><%= fab_ingredients_enabled ? "only matching recipes are displayed." : "you see all recipes." %></span>
          </p>
        </div>
      </div>
    </header>

    <section class="recipe-ingredients-picker">
      <div class="recipe-ingredients-selected">
        <div class="recipe-ingredients-empty-state">
          <p class="recipe-ingredients-empty-state-phrase">Add what is in your kitchen. Matching recipes move to the front.</p>
        </div>
        <div class="recipe-ingredients-selected-list" data-ingredients-fab-target="selectedList"></div>
      </div>

      <div class="recipe-ingredients-field">
        <div class="recipe-ingredients-input-group">
          <input id="recipe-ingredients-input" class="input" type="text" placeholder="Tomato, eggs, parsley..." autocomplete="off" role="combobox" aria-label="Ingredient name" aria-autocomplete="list" aria-expanded="false" aria-controls="recipe-ingredients-options" data-ingredients-fab-target="input" data-action="input->ingredients-fab#search keydown->ingredients-fab#keydown blur->ingredients-fab#blur">
          <button type="button" class="btn recipe-ingredients-photo-trigger" data-variant="outline" data-ingredients-fab-target="imageTrigger" data-action="click->ingredients-fab#openImageDialog" aria-label="Scan photo or image URL" aria-controls="recipe-ingredients-image-dialog">
            <span class="recipe-ingredients-photo-icons" aria-hidden="true">
              <%= icon_svg(:sparkles, class_name: "recipe-ingredients-photo-sparkles") %>
              <%= icon_svg(:camera, class_name: "recipe-ingredients-photo-camera") %>
            </span>
          </button>
        </div>
        <div id="recipe-ingredients-options" class="recipe-ingredients-options" role="listbox" data-ingredients-fab-target="options" hidden></div>
      </div>
    </section>
  </div>

  <dialog id="recipe-ingredients-image-dialog" class="recipe-ingredients-image-dialog" data-ingredients-fab-target="imageDialog" data-action="click->ingredients-fab#closeImageDialogFromBackdrop cancel->ingredients-fab#cancelImageDialog">
    <%= form_with scope: :image, url: ingredient_image_path, multipart: true, html: { class: "recipe-ingredients-image-form", data: { ingredients_fab_target: "imageForm", action: "submit->ingredients-fab#submitImage" } } do |form| %>
      <header class="recipe-ingredients-image-header">
        <div>
          <h2>Fill ingredients from photo</h2>
        </div>
        <button type="button" class="recipe-ingredients-image-close" data-action="click->ingredients-fab#closeImageDialog" aria-label="Close">
          <span aria-hidden="true"></span>
        </button>
      </header>

      <div class="recipe-ingredients-image-idle" data-ingredients-fab-target="imageIdle">
        <div class="recipe-ingredients-image-dropzone" role="button" tabindex="0" aria-label="Choose or drop a photo" data-ingredients-fab-target="imageDropzone" data-action="click->ingredients-fab#chooseImageFile keydown->ingredients-fab#imageDropzoneKeydown dragenter->ingredients-fab#dragImageFile dragover->ingredients-fab#dragImageFile dragleave->ingredients-fab#leaveImageFile drop->ingredients-fab#dropImageFile">
          <%= form.file_field :file, accept: "image/jpeg,image/png,image/webp,image/gif", class: "recipe-ingredients-image-file-input", aria: { label: "Photo" }, data: { ingredients_fab_target: "imageFile", action: "change->ingredients-fab#selectImageFile" } %>
          <span class="recipe-ingredients-image-drop-icon" aria-hidden="true">
            <%= icon_svg(:sparkles, class_name: "recipe-ingredients-image-drop-sparkles") %>
            <%= icon_svg(:camera, class_name: "recipe-ingredients-image-drop-camera") %>
          </span>
          <strong>Drop a photo here</strong>
        </div>

        <div class="recipe-ingredients-image-divider"><span>or paste an image URL</span></div>

        <div class="field">
          <%= form.label :url, "Image URL" %>
          <%= form.url_field :url, class: "input", placeholder: "https://example.com/fridge.jpg", autocomplete: "off", data: { ingredients_fab_target: "imageUrl", action: "paste->ingredients-fab#pasteImageUrl keydown->ingredients-fab#imageUrlKeydown" } %>
        </div>

        <p class="recipe-ingredients-image-status" data-ingredients-fab-target="imageStatus" role="status" hidden></p>
        <p class="recipe-ingredients-image-error" data-ingredients-fab-target="imageError" role="alert" hidden></p>

        <footer class="recipe-ingredients-image-actions">
          <button type="button" class="btn" data-variant="outline" data-action="click->ingredients-fab#closeImageDialog">Cancel</button>
        </footer>
      </div>

      <div class="recipe-ingredients-image-thinking" data-ingredients-fab-target="imageThinking" role="status" hidden>
        <span class="recipe-ingredients-image-spinner" aria-hidden="true">
          <span class="recipe-ingredients-image-star recipe-ingredients-image-star--one"></span>
          <span class="recipe-ingredients-image-star recipe-ingredients-image-star--two"></span>
          <span class="recipe-ingredients-image-star recipe-ingredients-image-star--three"></span>
          <span class="recipe-ingredients-image-star recipe-ingredients-image-star--four"></span>
        </span>
        <strong>Reading your photo...</strong>
        <span>Pen is matching what it sees to your basket.</span>
      </div>
    <% end %>
  </dialog>

  <button type="button" class="btn recipe-ingredients-fab-button" data-variant="outline" data-ingredients-fab-target="trigger" data-action="click->ingredients-fab#toggle" data-state="disabled" aria-label="Ingredients: add what you have" aria-controls="recipe-ingredients-panel" aria-expanded="false">
    <%= icon_svg(:ingredients, class_name: "recipe-ingredients-fab-icon") %>
    <span class="sr-only" data-ingredients-fab-target="status">Add what you have</span>
  </button>
</section>
