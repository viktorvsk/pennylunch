<div id="recipe-category-combobox" class="combobox" data-auto-highlight="true" data-auto-submit-on-change="true">
  <button type="button" class="btn recipe-toolbar-category recipe-toolbar-control" data-state="<%= selected_category.present? ? "active" : "inactive" %>" data-variant="outline" data-size="icon" data-tooltip="<%= tooltip %>" data-side="bottom" data-align="end" aria-label="Category" aria-haspopup="listbox" aria-expanded="false" aria-controls="recipe-category-listbox">
    <span class="sr-only" data-value data-placeholder="All categories"><%= selected_category_label.presence || "All categories" %></span>
    <%= icon_svg(:category) %>
  </button>

  <div id="recipe-category-popover" data-popover data-side="bottom" data-align="end" aria-hidden="true" class="recipe-toolbar-category-popover">
    <div class="input-group">
      <input type="text" role="combobox" placeholder="Search category" autocomplete="off" autocorrect="off" spellcheck="false" aria-autocomplete="list" aria-expanded="false" aria-controls="recipe-category-listbox" />
    </div>
    <div role="listbox" id="recipe-category-listbox" class="recipe-toolbar-category-listbox" aria-orientation="vertical" data-empty="No categories found.">
      <div role="option" data-value="" data-label="All categories">All categories</div>
      <% categories.each do |category| %>
        <% category_display = category_labels.fetch(category, category_heading(category)) %>
        <div role="option" data-value="<%= category %>" data-label="<%= category_display %>"><%= category_display %></div>
      <% end %>
    </div>
  </div>

  <%= hidden_field_tag :category, selected_category.to_s %>
</div>
