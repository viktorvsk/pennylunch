<%= turbo_frame_tag "recipe-results-frame", data: { turbo_action: "advance" } do %>
  <main class="recipe-page">
    <% if selected_category.present? %>
      <section class="recipe-title-section">
        <h1 class="recipe-page-title"><%= recipe_category_labels.fetch(selected_category) %></h1>
      </section>
    <% end %>

    <% if recipes.any? %>
      <% selected_ingredient_names = Array(filters["ingredients"]).filter_map { it.to_s.squish.presence }.uniq %>
      <%= render "results_grid", recipes:, next_page_url:, selected_ingredient_names: %>
    <% else %>
      <%= render "empty_results" %>
    <% end %>
  </main>
<% end %>
