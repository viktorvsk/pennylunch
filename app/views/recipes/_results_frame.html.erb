<%= turbo_frame_tag "recipe-results-frame", data: { turbo_action: "advance" } do %>
  <main class="recipe-page">
    <% if selected_category.present? %>
      <section class="recipe-title-section">
        <p class="recipe-page-subtitle">Category</p>
        <h1 class="recipe-page-title"><%= category_heading(selected_category) %></h1>
      </section>
    <% end %>

    <% if recipes.any? %>
      <%= render "results_grid", recipes:, next_page_url: %>
    <% else %>
      <%= render "empty_results", random_category: %>
    <% end %>
  </main>
<% end %>
