<%= turbo_frame_tag "recipe-results-frame", data: { turbo_action: "advance" } do %>
  <% category_labels = recipe_catalog[:category_labels] %>

  <main class="recipe-page">
    <% if selected_category.present? %>
      <section class="recipe-title-section">
        <h1 class="recipe-page-title"><%= category_labels.fetch(selected_category) %></h1>
      </section>
    <% end %>

    <% if recipes.any? %>
      <%= render "recipes/results_grid", recipes:, filters:, next_page_url: %>
    <% else %>
      <%= render "recipes/empty_results", category_labels: %>
    <% end %>
  </main>
<% end %>
