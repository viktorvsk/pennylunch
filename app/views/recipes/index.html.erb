<% content_for :title, "Recipes" %>
<% current_sort = filters["sort"].presence || "time_asc" %>
<% quick_active = filters["quick"].to_s == "1" %>
<% popular_active = filters["popular"].to_s == "1" %>
<% selected_category_label = selected_category.present? ? category_labels.fetch(selected_category, category_heading(selected_category)) : nil %>
<% category_tooltip = selected_category_label.present? ? "Category: #{selected_category_label}" : "Category: all categories" %>
<% category_slugs = search.category_options.to_h { |category| [ category, Recipe.category_slug_for(category) ] } %>

<header class="recipe-toolbar sticky top-0 z-40 w-full min-w-0 border-b bg-background">
  <div class="flex h-16 w-full min-w-0 items-center gap-2 px-3 sm:px-4">
    <%= link_to "PennyLunch", root_path, class: "recipe-toolbar-brand shrink-0 text-base font-semibold tracking-normal" %>

    <%= form_with url: recipes_path, method: :get, local: true, html: { data: { auto_submit_form: true, filter_root: recipes_path, category_slugs: category_slugs.to_json } }, class: "flex min-w-0 flex-1 items-center gap-2" do |form| %>
      <%= hidden_field_tag :sort, current_sort %>
      <%= hidden_field_tag :ingredients, filters["ingredients"], data: { ingredients_filter_hidden: true } %>

      <div class="min-w-0 flex-1">
        <%= form.label :q, "Title", class: "sr-only" %>
        <%= form.search_field :q, value: filters["q"], class: "input h-10 w-full", placeholder: "Title", autocomplete: "off", data: { auto_submit_debounce: 350 } %>
      </div>

      <span class="recipe-toolbar-loading flex size-5 shrink-0 items-center justify-center" aria-hidden="true">
        <span class="infinite-scroll-spinner"></span>
      </span>

      <label class="btn recipe-toolbar-toggle size-10 shrink-0 cursor-pointer" data-state="<%= quick_active ? "active" : "inactive" %>" data-variant="outline" data-size="icon" data-tooltip="Quick: <%= quick_active ? "on" : "off" %>. Shows recipes under 30 minutes." data-side="bottom" data-align="center">
        <%= check_box_tag :quick, "1", quick_active, class: "sr-only", role: "switch", aria: { label: "Quick recipes" }, data: { auto_submit_on_change: true } %>
        <%= icon_svg(:quick) %>
      </label>

      <label class="btn recipe-toolbar-toggle size-10 shrink-0 cursor-pointer" data-state="<%= popular_active ? "active" : "inactive" %>" data-variant="outline" data-size="icon" data-tooltip="Popular: <%= popular_active ? "on" : "off" %>. Shows recipes rated above 4.8." data-side="bottom" data-align="center">
        <%= check_box_tag :popular, "1", popular_active, class: "sr-only", role: "switch", aria: { label: "Popular recipes" }, data: { auto_submit_on_change: true } %>
        <%= icon_svg(:popular) %>
      </label>

      <div id="recipe-category-combobox" class="combobox shrink-0" data-auto-highlight="true" data-auto-submit-on-change="true">
        <button type="button" class="btn recipe-toolbar-category size-10" data-state="<%= selected_category.present? ? "active" : "inactive" %>" data-variant="outline" data-size="icon" data-tooltip="<%= category_tooltip %>" data-side="bottom" data-align="end" aria-label="Category" aria-haspopup="listbox" aria-expanded="false" aria-controls="recipe-category-listbox">
          <span class="sr-only" data-value data-placeholder="All categories"><%= selected_category_label.presence || "All categories" %></span>
          <%= icon_svg(:category) %>
        </button>
        <div id="recipe-category-popover" data-popover data-side="bottom" data-align="end" aria-hidden="true" class="w-72">
          <div class="input-group">
            <input type="text" role="combobox" placeholder="Search category" autocomplete="off" autocorrect="off" spellcheck="false" aria-autocomplete="list" aria-expanded="false" aria-controls="recipe-category-listbox" />
          </div>
          <div role="listbox" id="recipe-category-listbox" class="max-h-80 overflow-y-auto" aria-orientation="vertical" data-empty="No categories found.">
            <div role="option" data-value="" data-label="All categories">All categories</div>
            <% search.category_options.each do |category| %>
              <% category_display = category_labels.fetch(category, category_heading(category)) %>
              <div role="option" data-value="<%= category %>" data-label="<%= category_display %>"><%= category_display %></div>
            <% end %>
          </div>
        </div>
        <%= hidden_field_tag :category, selected_category.to_s %>
      </div>

      <div id="recipe-sort-menu" class="dropdown-menu shrink-0">
        <button type="button" class="btn size-10" data-variant="outline" data-size="icon" data-tooltip="Sort: <%= recipe_sort_label(current_sort) %>" data-side="bottom" data-align="end" aria-label="Sort" aria-haspopup="menu" aria-controls="recipe-sort-options" aria-expanded="false">
          <%= icon_svg(:sort) %>
        </button>
        <div id="recipe-sort-popover" data-popover data-side="bottom" data-align="end" aria-hidden="true" class="w-56">
          <div role="menu" id="recipe-sort-options" aria-labelledby="recipe-sort-menu">
            <% recipe_sort_options.each do |value, label| %>
              <%= link_to recipe_filter_path(filters.merge("sort" => value, "page" => nil)), role: "menuitem", class: "flex items-center justify-between gap-3", aria: { current: current_sort == value ? "true" : nil } do %>
                <span><%= label %></span>
                <% if current_sort == value %>
                  <%= icon_svg(:check, class_name: "size-4 text-primary") %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%= link_to icon_svg(:settings), "/maintenance_tasks", class: "btn size-10 shrink-0", data: { variant: "outline", size: "icon", tooltip: "Open maintenance tasks", side: "bottom", align: "end" }, aria: { label: "Maintenance" } %>
  </div>
</header>

<%= render "results_frame", search:, recipes:, selected_category:, filters:, next_page_url:, random_category: %>
