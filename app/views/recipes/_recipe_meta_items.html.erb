<span class="recipe-meta-item">
  <%= icon_svg(:user, class_name: "size-3.5") %>
  <span class="recipe-meta-text"><%= recipe.author.presence || "Unknown author" %></span>
</span>

<% if recipe.total_time.to_i.positive? %>
  <span class="recipe-meta-item" data-tooltip="<%= recipe_time_tooltip(recipe) %>" data-side="<%= tooltip_side %>" data-align="center">
    <%= icon_svg(:clock, class_name: "size-3.5") %>
    <span><%= recipe_duration_text(recipe.total_time) %></span>
  </span>
<% end %>
