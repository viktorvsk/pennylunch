<% toolbar = recipe_toolbar_state(filters:, selected_category:) %>
<header class="recipe-toolbar">
  <div class="recipe-toolbar-inner">
    <%= render "toolbar_brand" %>

    <%= form_with url: recipes_path, method: :get, local: true, html: { data: { controller: "auto-submit", action: "submit->auto-submit#submit input->auto-submit#input change->auto-submit#change", auto_submit_filter_root_value: recipes_path } }, class: "recipe-toolbar-form" do |form| %>
      <%= hidden_field_tag :sort, toolbar.current_sort %>
      <span data-auto-submit-target="ingredients">
        <% Array(filters["ingredients"]).each do |name| %>
          <%= hidden_field_tag "ingredients[]", name %>
        <% end %>
      </span>

      <div class="recipe-toolbar-search">
        <%= form.label :q, "Title", class: "sr-only" %>
        <%= form.search_field :q, value: filters["q"], class: "input", placeholder: "Search recipes", autocomplete: "off", data: { auto_submit_delay: 350 } %>
      </div>

      <%= render "toolbar_filter_toggle", name: :quick, active: toolbar.quick_active, aria_label: "Quick recipes", icon: :quick, tooltip: "Quick: #{toolbar.quick_active ? "on" : "off"}. Shows recipes under 30 minutes." %>
      <%= render "toolbar_filter_toggle", name: :popular, active: toolbar.popular_active, aria_label: "Popular recipes", icon: :popular, tooltip: "Popular: #{toolbar.popular_active ? "on" : "off"}. Shows recipes rated above 4.8." %>
      <%= render "toolbar_category_combobox", toolbar: %>
      <%= render "toolbar_sort_menu", toolbar:, filters: %>
    <% end %>

    <%= render "toolbar_admin_link" %>
  </div>
</header>
