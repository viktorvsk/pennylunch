<section class="recipe-title-section">
  <h1 class="recipe-page-title"><%= recipe.title %></h1>
  <% if recipe.category_normalized.present? %>
    <%= link_to recipe.category, recipe_filter_path("category" => recipe.category_normalized), class: "recipe-card-category" %>
  <% end %>
  <%= link_to "Back to all recipes", recipes_path, class: "recipe-ingredient-link" %>
</section>
