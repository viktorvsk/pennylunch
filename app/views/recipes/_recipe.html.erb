<% ingredient_names = recipe_ingredient_names(recipe) %>
<% ingredient_catalog_names = recipe_ingredient_catalog_names(recipe) %>
<% ingredient_summary = ingredient_name_summary(recipe) %>
<% required_ingredient_names = recipe_required_ingredient_names(recipe) %>
<% selected_ingredient_names = local_assigns.fetch(:selected_ingredient_names, []) %>
<% readiness = recipe_match_readiness(required_ingredient_names, selected_ingredient_names) if required_ingredient_names.any? %>

<article class="recipe-card">
  <%= link_to recipe_path(recipe), class: "recipe-card-link", data: { turbo_frame: "_top" } do %>
    <div class="recipe-card-image recipe-card-image--index">
      <%= image_tag recipe.display_image_url, alt: "", loading: "lazy" %>
    </div>
  <% end %>

  <div class="recipe-card-body">
    <header class="recipe-card-header">
      <div class="recipe-card-heading">
        <h2 class="recipe-card-title">
          <%= link_to recipe.title, recipe_path(recipe), data: { turbo_frame: "_top" } %>
        </h2>
        <% if recipe.category_normalized.present? %>
          <%= link_to category_label(recipe), recipe_filter_path("category" => recipe.category_normalized), class: "recipe-card-category", data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
      <%= rating_stars(recipe.ratings, class_name: "recipe-rating") %>
    </header>

    <% if ingredient_names.any? %>
      <p class="recipe-card-ingredients" data-ingredient-matches-target="summary" data-ingredient-names="<%= ingredient_names.to_json %>" data-ingredient-catalog-names="<%= ingredient_catalog_names.to_json %>" data-visible-limit="<%= IngredientsHelper::DEFAULT_INGREDIENT_SUMMARY_LIMIT %>"><%= ingredient_summary %></p>
    <% end %>

    <footer class="recipe-card-footer">
      <%= render "recipe_meta_items", recipe:, tooltip_side: "top" %>
      <% if readiness %>
        <span class="recipe-match-readiness" data-ingredient-matches-target="readiness" data-required-ingredient-names="<%= required_ingredient_names.to_json %>" data-state="<%= readiness.ready ? "ready" : "partial" %>" data-tooltip="<%= readiness.tooltip %>" data-side="top" data-align="end" aria-label="<%= readiness.tooltip %>">
          <%= icon_svg(:basket, class_name: "size-3.5") %>
          <span data-readiness-label><%= readiness.label %></span>
        </span>
      <% end %>
    </footer>
  </div>
</article>
