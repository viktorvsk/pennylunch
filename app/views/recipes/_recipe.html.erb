<article class="card overflow-hidden">
  <%= link_to recipe_path(recipe.slug), class: "block focus:outline-none focus:ring-2 focus:ring-ring" do %>
    <div class="aspect-[4/3] w-full overflow-hidden bg-muted">
      <%= image_tag recipe.display_image_url, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
    </div>
  <% end %>
  <header class="gap-2">
    <div class="flex items-start justify-between gap-3">
      <h2 class="line-clamp-2 text-lg font-semibold">
        <%= link_to recipe.title, recipe_path(recipe.slug), class: "hover:underline" %>
      </h2>
      <%= rating_stars(recipe.ratings) %>
    </div>
    <p class="text-sm text-muted-foreground"><%= recipe.author.presence || "Unknown author" %></p>
  </header>
  <section class="flex flex-wrap items-center gap-2 text-sm">
    <span class="badge" data-variant="secondary"><%= category_label(recipe) %></span>
    <% if recipe.total_time_known? %>
      <span title="Prep: <%= recipe.prep_time %> min, cook: <%= recipe.cook_time %> min"><%= recipe.total_time %> min</span>
    <% end %>
  </section>
</article>
