<% ingredient_names = recipe_ingredient_names(recipe) %>
<% ingredient_summary = ingredient_name_summary(recipe) %>

<article class="recipe-card flex h-full flex-col rounded-lg border bg-card">
  <%= link_to recipe_path(recipe.slug), class: "block focus:outline-none focus:ring-2 focus:ring-ring", data: { turbo_frame: "_top" } do %>
    <div class="recipe-card-image aspect-[4/3] w-full bg-muted">
      <%= image_tag recipe.display_image_url, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
    </div>
  <% end %>

  <div class="flex flex-1 flex-col p-4">
    <header class="flex items-start justify-between gap-3">
      <div class="min-w-0 space-y-1">
        <h2 class="line-clamp-2 text-lg font-semibold leading-snug">
          <%= link_to recipe.title, recipe_path(recipe.slug), class: "hover:underline", data: { turbo_frame: "_top" } %>
        </h2>
        <% if recipe.category_normalized.present? %>
          <%= link_to category_label(recipe), recipe_filter_path("category" => recipe.category_normalized), class: "recipe-card-category text-sm font-medium text-muted-foreground hover:text-foreground hover:underline", data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
      <%= rating_stars(recipe.ratings, class_name: "recipe-rating shrink-0") %>
    </header>

    <% if ingredient_names.any? %>
      <p class="recipe-card-ingredients mt-3 line-clamp-2 text-sm leading-6 text-muted-foreground" data-recipe-ingredients data-ingredient-names="<%= ingredient_names.to_json %>" data-visible-limit="8"><%= ingredient_summary %></p>
    <% end %>

    <footer class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 text-sm text-muted-foreground">
      <span class="inline-flex min-w-0 items-center gap-1.5">
        <%= icon_svg(:user, class_name: "size-3.5 shrink-0") %>
        <span class="truncate"><%= recipe.author.presence || "Unknown author" %></span>
      </span>
      <% if recipe.total_time_known? %>
        <span class="inline-flex items-center gap-1.5" data-tooltip="<%= recipe_time_tooltip(recipe) %>" data-side="bottom" data-align="center">
          <%= icon_svg(:clock, class_name: "size-3.5 shrink-0") %>
          <span><%= recipe.total_time %> min</span>
        </span>
      <% end %>
    </footer>
  </div>
</article>
