<% ingredient_names = recipe.ingredient_names %>
<% ingredient_metadata = local_assigns.fetch(:ingredient_metadata) { Ingredient.catalog_metadata } %>
<% ingredient_data = ingredient_names.map { |name| entry = ingredient_metadata[name]; { name:, matchName: entry&.[](:name), optional: entry&.[](:optional) } } %>
<% required_names = ingredient_data.filter_map { it[:matchName] unless it[:optional] }.uniq %>
<% selected_ingredient_names = local_assigns.fetch(:selected_ingredient_names, []) %>
<% matched_ingredient_count = (required_names & selected_ingredient_names).size %>
<% readiness_tooltip = "Matches #{matched_ingredient_count} of #{required_names.size} required ingredients in your selected ingredients. Pantry staples are not counted." if required_names.any? %>
<% ingredient_summary_suffix = ingredient_names.size > 8 ? " + #{ingredient_names.size - 8} more" : "" %>

<article class="recipe-card">
  <%= link_to recipe_path(recipe), class: "recipe-card-link", data: { turbo_frame: "_top" } do %>
    <div class="recipe-card-image recipe-card-image--index">
      <%= image_tag recipe.display_image_url, alt: "", loading: "lazy" %>
    </div>
  <% end %>

  <div class="recipe-card-body">
    <header class="recipe-card-header">
      <div class="recipe-card-heading">
        <h2 class="recipe-card-title">
          <%= link_to recipe.title, recipe_path(recipe), data: { turbo_frame: "_top" } %>
        </h2>
        <% if recipe.category_normalized.present? %>
          <%= link_to recipe.category, recipe_filter_path("category" => recipe.category_normalized), class: "recipe-card-category", data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
      <%= rating_stars(recipe.ratings) %>
    </header>

    <% if ingredient_data.any? %>
      <p class="recipe-card-ingredients" data-ingredient-matches-target="summary" data-recipe-ingredients="<%= ingredient_data.map { it.slice(:name, :matchName) }.to_json %>"><%= "#{ingredient_names.first(8).join(", ")}#{ingredient_summary_suffix}" %></p>
    <% end %>

    <footer class="recipe-card-footer">
      <%= render "recipe_meta_items", recipe:, tooltip_side: "top" %>
      <% if required_names.any? %>
        <span class="recipe-match-readiness" data-ingredient-matches-target="readiness" data-required-ingredient-names="<%= required_names.to_json %>" data-state="<%= matched_ingredient_count == required_names.size ? "ready" : "partial" %>" data-tooltip="<%= readiness_tooltip %>" data-side="top" data-align="end" aria-label="<%= readiness_tooltip %>">
          <%= icon_svg(:basket, class_name: "size-3.5") %>
          <span data-readiness-label><%= "#{((matched_ingredient_count.to_f / required_names.size) * 100).round}%" %></span>
        </span>
      <% end %>
    </footer>
  </div>
</article>
