<% selected_ingredient_names = Array(filters["ingredients"]).filter_map { it.to_s.squish.presence }.uniq %>
<% ingredient_metadata = Ingredient.catalog_metadata %>

<section id="recipe-results" class="recipe-results-grid">
  <%= render partial: "recipes/recipe", collection: recipes, as: :recipe, locals: { selected_ingredient_names:, ingredient_metadata: } %>
</section>

<% if next_page_url %>
  <div class="recipe-results-loading" data-controller="infinite-scroll" data-infinite-scroll-next-url-value="<%= next_page_url %>" aria-live="polite">
    <span class="recipe-results-loading-status" data-infinite-scroll-target="status">
      <span class="infinite-scroll-spinner" aria-hidden="true"></span>
      <span>Loading more recipes...</span>
    </span>
  </div>
<% end %>
