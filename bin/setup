#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def production?
  ENV["RAILS_ENV"] == "production"
end

def elapsed(label)
  start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  yield
  duration = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - start).round(2)
  puts "  #{label} (#{duration}s)"
end

def python_path
  File.expand_path(ENV.fetch("INGREDIENT_PARSER_PYTHON", ".venv/bin/python"), APP_ROOT)
end

def python_venv_path
  File.expand_path("..", File.dirname(python_path))
end

def python_environment
  { "NLTK_DATA" => ENV.fetch("NLTK_DATA", File.join(python_venv_path, "nltk_data")) }
end

def python_dependencies_ready?
  return false unless File.executable?(python_path)

  system(python_environment, python_path, "-c", "import ingredient_parser", out: File::NULL, err: File::NULL)
end

FileUtils.chdir APP_ROOT do
  abort "--reset is not allowed in production" if production? && ARGV.include?("--reset")

  $stdout.sync = true
  $stderr.sync = true

  puts "== Installing dependencies =="
  elapsed("Dependencies") do
    system("bundle check") || system!("bundle install")
  end

  unless production? && python_dependencies_ready?
    puts "\n== Installing Python dependencies =="
    elapsed("Python dependencies") do
      system!("python3", "-m", "venv", python_venv_path) unless File.executable?(python_path)
      system!(python_path, "-m", "pip", "install", "--upgrade", "pip")
      system!(python_path, "-m", "pip", "install", "-r", "requirements.txt")
      system!(python_environment, python_path, "-c", "import nltk, os; nltk.download('averaged_perceptron_tagger_eng', download_dir=os.environ['NLTK_DATA'], quiet=True); from ingredient_parser import parse_ingredient; parse_ingredient('1 cup flour')")
    end
  end

  puts "\n== Preparing database =="
  elapsed("Database") do
    if ARGV.include?("--reset")
      system! "bin/rails db:reset"
    else
      system! "bin/rails db:prepare"
    end
  end

  unless production?
    puts "\n== Removing old logs and tempfiles =="
    elapsed("Logs and tempfiles") do
      system! "bin/rails log:clear tmp:clear"
    end
  end

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
