#!/usr/bin/env bash
set -euo pipefail

start_time=$SECONDS
secret_key_base=$(ruby -rsecurerandom -e 'print SecureRandom.hex(64)')

if [ -n "${RAILS_MASTER_KEY:-}" ]; then
  master_key="$RAILS_MASTER_KEY"
elif [ -f config/master.key ]; then
  master_key=$(tr -d '\n' < config/master.key)
else
  printf "FAILED: production boot\nRAILS_MASTER_KEY is required when config/master.key is absent.\n"
  exit 1
fi

set +e
output=$(env \
  DISABLE_SPRING=1 \
  PENNY_LUNCH_DATABASE_PASSWORD=dummy \
  RAILS_LOG_LEVEL=info \
  RAILS_MASTER_KEY="$master_key" \
  SECRET_KEY_BASE="${SECRET_KEY_BASE:-$secret_key_base}" \
  ./bin/rails runner -e production 'true' 2>&1)
exit_code=$?
set -e
elapsed=$((SECONDS - start_time))

if [ "$exit_code" -ne 0 ]; then
  printf "FAILED: production boot (%ss)\n%s\n" "$elapsed" "$output"
  exit "$exit_code"
fi

printf "SUCCESS: production boot (%ss)\n" "$elapsed"
