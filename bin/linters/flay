#!/usr/bin/env bash
set -euo pipefail

flay_mass="${FLAY_MASS:-100}"
flay_args=()
paths=()

for arg in "$@"; do
  if [[ "$arg" == -* ]]; then
    flay_args+=("$arg")
  else
    paths+=("$arg")
  fi
done

if [ "${#paths[@]}" -eq 0 ]; then
  paths=(app lib)
fi

if [ "${#flay_args[@]}" -gt 0 ]; then
  output=$(bundle exec flay --mass "$flay_mass" "${flay_args[@]}" "${paths[@]}")
else
  output=$(bundle exec flay --mass "$flay_mass" "${paths[@]}")
fi
exit_code=$?

printf "%s\n" "$output"

if [ "$exit_code" -ne 0 ]; then
  exit "$exit_code"
fi

if printf "%s\n" "$output" | grep -q "Total score (lower is better) = 0"; then
  exit 0
fi

exit 1
