# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle
/.venv
__pycache__/
*.py[cod]

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore runtime storage.
/storage/*
!/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
/public/assets

# Ignore development files
/.agents
/.devcontainer
/.reek.yml
/.rubocop.yml
/AGENTS.md
/coverage
/docs
/Procfile.dev
/README.md
/skills-lock.json
/spec

# Ignore Docker-related files
/.dockerignore
/docker-compose*.yaml
/docker-compose*.yml
/docker/
/Dockerfile*
